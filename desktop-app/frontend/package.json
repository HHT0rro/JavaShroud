{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --config vite.mock.config.ts --open /debug.html",
    "build": "vue-tsc -b && vite build",
    "check": "node ./run-frontend-checks.mjs",
    "check:capabilities": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/capability-parser.check.ts",
    "check:events": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/event-parser.check.ts",
    "check:pass-selections": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/pass-selection-targeting.check.ts && node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/state-pass-selection.check.ts",
    "check:class-tree-view": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/class-tree-view.check.ts && node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/pass-scope-tabs.check.ts",
    "check:config": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/config-toml.check.ts",
    "check:input-flow": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/input-flow-controller.check.ts",
    "check:state-dependencies": "node --import ./scripts/register-ts-loader.mjs src/modules/obfuscation/state-dependencies.check.ts",
    "check:reorder": "node test-reorder-constraints.mjs",
    "check:mock-scenarios": "node --import ./scripts/register-ts-loader.mjs src/debug/mock-scenarios.check.ts",
    "preview": "vite preview",
    "sync:appicon": "python ../scripts/sync_app_icon.py"
  },
  "dependencies": {
    "@vueuse/motion": "^3.0.3",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.34",
    "vuedraggable": "^4.1.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
